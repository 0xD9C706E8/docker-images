#!/usr/bin/env bash
# Entrypoint for the openchamber web UI image.

set -euo pipefail

HOME="/home/openchamber"

# Default openchamber settings: opt out of anonymous usage reports so the app
# does not phone home on first run. Users can flip this back in the Appearance
# > Privacy settings UI, or by editing the file directly.
OPENCHAMBER_DATA_DIR="${OPENCHAMBER_DATA_DIR:-${HOME}/.config/openchamber}"
OPENCHAMBER_SETTINGS_FILE="${OPENCHAMBER_DATA_DIR}/settings.json"
if [ ! -f "${OPENCHAMBER_SETTINGS_FILE}" ]; then
  mkdir --parents "${OPENCHAMBER_DATA_DIR}"
  if [ -w "${OPENCHAMBER_DATA_DIR}" ]; then
    echo "[entrypoint] writing default openchamber settings (reportUsage=false)"
    cat > "${OPENCHAMBER_SETTINGS_FILE}" << 'EOF'
{
  "reportUsage": false
}
EOF
  else
    echo "[entrypoint] warning: cannot write ${OPENCHAMBER_SETTINGS_FILE}, continuing without default config" >&2
  fi
fi

SSH_DIR="${HOME}/.ssh"
SSH_PRIVATE_KEY_PATH="${SSH_DIR}/id_ed25519"
SSH_PUBLIC_KEY_PATH="${SSH_PRIVATE_KEY_PATH}.pub"

mkdir --parents "${SSH_DIR}"

ssh_dir_perms=$(stat --format=%a "${SSH_DIR}" 2> /dev/null || echo "")
if [ -n "${ssh_dir_perms}" ] && [ "${ssh_dir_perms}" != "700" ]; then
  echo "[entrypoint] warning: ${SSH_DIR} has mode ${ssh_dir_perms}, expected 700; ssh may complain" >&2
fi

if [ ! -f "${SSH_PRIVATE_KEY_PATH}" ] || [ ! -f "${SSH_PUBLIC_KEY_PATH}" ]; then
  if [ ! -w "${SSH_DIR}" ]; then
    echo "[entrypoint] warning: ssh key missing and ${SSH_DIR} is not writable, continuing without SSH key" >&2
  else
    echo "[entrypoint] generating SSH key..."
    if ! ssh-keygen -t ed25519 -N "" -f "${SSH_PRIVATE_KEY_PATH}" > /dev/null 2>&1; then
      echo "[entrypoint] warning: failed to generate SSH key, continuing without SSH key" >&2
    fi
  fi
fi

if [ -f "${SSH_PRIVATE_KEY_PATH}" ]; then
  ssh_priv_perms=$(stat --format=%a "${SSH_PRIVATE_KEY_PATH}" 2> /dev/null || echo "")
  if [ -n "${ssh_priv_perms}" ] && [ "${ssh_priv_perms}" != "600" ]; then
    echo "[entrypoint] warning: ${SSH_PRIVATE_KEY_PATH} has mode ${ssh_priv_perms}, expected 600; ssh will refuse to use it" >&2
  fi
fi

if [ -f "${SSH_PUBLIC_KEY_PATH}" ]; then
  ssh_pub_perms=$(stat --format=%a "${SSH_PUBLIC_KEY_PATH}" 2> /dev/null || echo "")
  if [ -n "${ssh_pub_perms}" ] && [ "${ssh_pub_perms}" != "644" ]; then
    echo "[entrypoint] warning: ${SSH_PUBLIC_KEY_PATH} has mode ${ssh_pub_perms}, expected 644" >&2
  fi
fi

if [ -f "${SSH_PUBLIC_KEY_PATH}" ]; then
  echo "[entrypoint] SSH public key:"
  cat "${SSH_PUBLIC_KEY_PATH}"
fi

# UI_PASSWORD is the legacy alias; OPENCHAMBER_UI_PASSWORD is canonical.
if [ -z "${OPENCHAMBER_UI_PASSWORD:-}" ] && [ -n "${UI_PASSWORD:-}" ]; then
  OPENCHAMBER_UI_PASSWORD="${UI_PASSWORD}"
  export OPENCHAMBER_UI_PASSWORD
fi

if [ -n "${OPENCHAMBER_UI_PASSWORD:-}" ]; then
  echo "[entrypoint] UI password set, enabling authentication"
fi

# This image ships no opencode-ai; OPENCODE_SKIP_START=true is set in the
# Dockerfile ENV. The operator points OpenChamber at an external OpenCode
# server via OPENCODE_HOST (e.g. http://opencode:4096).
if [ -z "${OPENCODE_HOST:-}" ]; then
  echo "[entrypoint] warning: OPENCODE_HOST is unset; OpenChamber has no OpenCode server to talk to" >&2
fi

# Bind to all interfaces so docker port mapping works inside a container.
# Otherwise the server would bind 127.0.0.1 and port mapping silently no-ops.
OPENCHAMBER_HOST="${OPENCHAMBER_HOST:-0.0.0.0}"
export OPENCHAMBER_HOST

echo "[entrypoint] starting..."

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

set -- node packages/web/bin/cli.js --foreground
if [ -n "${OPENCHAMBER_UI_PASSWORD:-}" ]; then
  set -- "$@" --ui-password "${OPENCHAMBER_UI_PASSWORD}"
fi
exec "$@"
